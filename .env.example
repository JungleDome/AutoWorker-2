CODEX_API_KEY=sk-... # optional if your Codex install already has a key
CODEX_BASE_URL=       # optional: override Codex base URL
CODEX_MODEL=gpt-4.1-mini
CODEX_SANDBOX=danger-full-access # read-only | workspace-write | danger-full-access
CODEX_APPROVAL=never             # never | on-request | on-failure | untrusted
CODEX_WORKDIR=                   # optional working directory for Codex runs
CODEX_NETWORK_ENABLED=true       # allow network tools (if supported in your setup)
CODEX_WEBSEARCH_ENABLED=false    # allow web search (if supported)

# Ticket storage
TICKET_STORAGE=file              # file | memory
TICKET_STORAGE_DIR=docs_ticket   # folder for file storage
